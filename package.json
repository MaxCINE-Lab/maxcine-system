{
  "name": "maxcine-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs start",
    "dev:stop": "node scripts/dev.mjs stop",
    "dev:status": "node scripts/dev.mjs status",
    "dev:web": "npm run dev -w @maxcine/web",
    "dev:api": "npm run dev -w @maxcine/api",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "test": "npm run build -w @maxcine/shared && node --test tests/security.test.mjs",
    "test:scanner": "npm run build -w @maxcine/shared && node scripts/test-barcode-scanner.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "build": "npm run build -w @maxcine/shared && npm run build -w @maxcine/web && npm run build -w @maxcine/api",
    "db:apply:local": "wrangler d1 migrations apply maxcine-db --local --persist-to work/gsx-d1 --config apps/api/wrangler.toml",
    "db:seed:local": "wrangler d1 execute maxcine-db --local --persist-to work/gsx-d1 --file apps/api/seed/0001_demo.sql --config apps/api/wrangler.toml"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "bwip-js": "^4.11.2",
    "concurrently": "^9.2.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.3",
    "wrangler": "^4.114.0"
  }
}
